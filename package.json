{
  "name": "ai-trading-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node server/index.mjs",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "eval:agent": "node scripts/agent-eval.mjs",
    "test:exchange-contract": "node scripts/exchange-contract-check.mjs",
    "migrate:tenant-resources": "node scripts/migrate-tenant-resources.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "smoke": "node scripts/healthcheck.mjs",
    "smoke:full": "SMOKE_ALLOW_MUTATIONS=true node scripts/smoke-test.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "backup": "node scripts/backup.mjs",
    "docx": "python3 scripts/build-unified-docx.py",
    "lint": "eslint src server scripts tests"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/network": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.1.0",
    "jszip": "^3.10.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "node-cron": "^4.5.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "simple-git": "^3.36.0",
    "undici": "^8.5.0",
    "vite": "^6.0.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5"
  }
}
