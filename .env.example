# Runtime
PORT=8787
HOST=127.0.0.1
# Docker/生产部署必须 HOST=0.0.0.0(deploy.sh 会硬校验,否则容器外 502)。
DATA_DIR=./data
AUTH_REQUIRED=true
ADMIN_PASSWORD=
PUBLIC_REGISTRATION_ENABLED=false
# closed | invite | waitlist | auto。公开入口只提交客户实例申请，不在 Owner 工作区创建用户。
PUBLIC_REGISTRATION_MODE=closed
# 同一宿主机允许预留/运行的客户实例总数；0 表示只收候补、不批准开通。
PUBLIC_MAX_TENANTS=0
PUBLIC_BASE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REGISTRATION_EMAIL_WEBHOOK_URL=
REGISTRATION_EMAIL_WEBHOOK_TOKEN=
REGISTRATION_RATE_LIMIT_SALT=
REGISTRATION_TERMS_VERSION=2026-08-09
REGISTRATION_PRIVACY_VERSION=2026-08-09
REGISTRATION_TERMS_URL=
REGISTRATION_PRIVACY_URL=
# 受限宿主机开通代理完成安装和验收前必须保持 false。
PROVISIONING_BROKER_ENABLED=false
# Keep false until every trading-domain repository is physically partitioned
# by tenant_id and cross-tenant authorization tests pass.
TENANT_ISOLATION_V2=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
LOGIN_MAX_ATTEMPTS=8

# SQLite is the default durable store. The file is created under DATA_DIR as
# trading-agent.sqlite and can migrate the old data/db.json on first boot.

# Live trading is disabled by default. Both switches must be true before
# private exchange write calls are allowed.
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_REAL_TRADING=false
REAL_ORDER_WRITE_ENABLED=false
MAX_LIVE_NOTIONAL_USDT=50
# Mandate 政策允许的上限（不会改写 Mandate 本身）。生产若要保留高于默认
# 5%/10% 的既有授权，必须在环境中显式声明并由生产预检留痕。
MANDATE_POLICY_MAX_SINGLE_RISK_PCT=5
MANDATE_POLICY_MAX_DAILY_LOSS_PCT=10
MANDATE_POLICY_MAX_WEEKLY_LOSS_PCT=20
REALTIME_RECONCILER_ENABLED=false
MIN_FORWARD_TRADES=30
KNOWLEDGE_SKILL_MIN_LIVE_TRADES=10
# Only these directories may be read by the local-path knowledge importer.
# Prefer file upload in remote deployments. Separate multiple roots with the OS path delimiter.
KNOWLEDGE_ALLOWED_PATHS=
KNOWLEDGE_SIGNAL_MAX_AGE_MS=7200000
PAPER_FEE_BPS=4
PAPER_SLIPPAGE_BPS=3
EVENT_RISK_PAST_WINDOW_MS=21600000
EVENT_RISK_FUTURE_WINDOW_MS=86400000

# OKX is the sole market-data and execution venue. Secrets are read only by exchange
# connectors and are never written to logs, traces, or frontend payloads.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_MARGIN_MODE=cross
# 注意:持仓模式(net/long_short)目前由交易所账户设置决定,后端不读取该配置。
OKX_DEMO_TRADING=false
OKX_BASE_URL=https://www.okx.com

# Security / operations
# external_hardened | bitlaunch_single_server. Single-server mode keeps the
# local hash chain and alerts as hard gates, but reports external KMS/WORM as warnings.
PRODUCTION_SECURITY_PROFILE=external_hardened
# Local development may use SECRETS_MASTER_KEY. Production must mount the KMS/Vault
# output directory at /run/secrets/trading-agent and use the file path below.
SECRETS_MASTER_KEY=
SECRETS_MASTER_KEY_FILE=/run/secrets/trading-agent/master_key
REQUIRE_EXTERNAL_KEY_PROVIDER=true
WORM_AUDIT_ENDPOINT=
WORM_AUDIT_TOKEN=
WORM_AUDIT_SINK_ID=primary
ALERT_WEBHOOK_URL=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-trading-agent
ETHERSCAN_API_KEY=
TRC20_USDT_RECEIVE_ADDRESS=
TRONGRID_API_KEY=

# OpenAI Responses API provider. When unset, Agent uses deterministic local
# strategy generation for development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Third-party Skill execution is containerized. Pre-pull or override this image
# in production if outbound image pulls are not allowed.
SKILL_SANDBOX_IMAGE=node:20-alpine

# ---- 安全闸门(fail-closed,均为实际生效的硬开关) ----
# 允许无主密钥的明文密钥存储——仅限本地开发,生产严禁 true。
ALLOW_INSECURE_SECRET_STORAGE=false
# 实盘前强制校验 API Key 权限(含提币权限必须为关);设 false 仅在只读模式下生效。
REQUIRE_API_PERMISSION_VERIFICATION=true
# 审计链完整性校验失败时拒绝运行(设 false 关闭,不建议)。
REQUIRE_AUDIT_CHAIN_OK=true
AUTH_SESSION_DAYS=1
REQUIRE_MFA_FOR_LIVE=false
# 备份先用 SQLite Online Backup 校验，再可选 AES-256-GCM 加密并复制到独立挂载目录。
# 加密密钥文件不得位于 data/、backups/ 或代码仓库；建议由宿主机只读挂载。
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_OFFSITE_DIR=
BACKUP_OFFSITE_HOST_DIR=./offsite-backups
BACKUP_KEEP_COUNT=14
RESTORE_DRILL_REQUIRE_ENCRYPTED=true
APP_RELEASE=dev

# ---- 交易语义与数据新鲜度(直接影响下单与 fail-closed 判定) ----
OKX_MARKET_TYPE=perpetual_swap
# 账户快照/微观结构过期即拒绝实盘(毫秒)。
MAX_ACCOUNT_SNAPSHOT_AGE_MS=600000
# Reject account snapshots whose timestamp is implausibly ahead of server time.
MAX_ACCOUNT_SNAPSHOT_FUTURE_SKEW_MS=30000
# Extra margin reserved for fees/costs when projecting post-trade utilization (0.001 = 0.1% of notional).
EXECUTION_MARGIN_FEE_BUFFER_RATE=0.001
MAX_MICROSTRUCTURE_AGE_MS=180000
# LLM 全字段事实守卫：enforce_core=硬改价格/账户/持仓/合约规格，其余字段影子记录；
# shadow=全部只记录；enforce_all=所有受支持当前事实均硬改。生产先保持 enforce_core 观察误报。
EVIDENCE_FACT_GUARD_MODE=enforce_core
# SRTL 执行前审核的最低盈亏比门槛。
SRTL_MIN_R=2.0
LIVE_WEIGHT_MIN_TRADES=10
IMPROVEMENT_MIN_NEW_CLOSES=10
REFLECTION_MIN_MEMO_USDT=1

# ---- 通知:飞书(deploy/README 必做项)与 Telegram 晒单 ----
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROFIT_POSTER_ENABLED=false
TELEGRAM_PROFIT_POSTER_MIN_PNL_USDT=0
TELEGRAM_PROFIT_POSTER_MIN_ROI_PCT=0
TELEGRAM_PROFIT_POSTER_COOLDOWN_MINUTES=240
# 观察哨使用独立 Telegram 群，不复用盈利海报 chat id，也不接收其它系统告警。
TELEGRAM_WATCH_NOTIFIER_ENABLED=false
TELEGRAM_WATCH_CHAT_ID=
TELEGRAM_WATCH_DAILY_DIGEST_ENABLED=false

# ---- 市场情报数据层 ----
# ME News 仅作补充聚合源，所有内容仍经过事实模型、新鲜度与证据约束。
ME_NEWS_ENABLED=true
EVENT_SOURCE_RETRIES=1
# Farside 公开 ETF 表格，无需 API Key；抓取失败或数据陈旧时明确返回 unavailable。
FARSIDE_ETF_ENABLED=true

# ---- 知识嵌入(语义检索;不配则退回词频检索) ----
# gemini | openai;模型默认 gemini-embedding-001 / text-embedding-3-small。
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ---- 运维/多租户 ----
OWNER_EMAIL=
# 执行租约 fencing 标识,多实例部署时必须唯一;默认 pid-<pid>。
INSTANCE_ID=
# 支付回调签名密钥(TRC20 验证回调)。
PAYMENT_WEBHOOK_SECRET=
# 一次性迁移守卫:仅在执行 scripts/migrate-tenant-resources.mjs 时设 true。
# CONFIRM_TENANT_RESOURCE_MIGRATION=false

# ---- 出站代理(本机 Clash 等;ws 与 fetch 都会走) ----
HTTP_PROXY=
HTTPS_PROXY=
