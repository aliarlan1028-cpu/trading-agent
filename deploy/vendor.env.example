# 统一提供给所有客户实例的 LLM key。
# 用法：在服务器上复制为 deploy/vendor.env 并填入真实 key（chmod 600，切勿提交仓库）。
#   cp deploy/vendor.env.example deploy/vendor.env && chmod 600 deploy/vendor.env
# provision-tenant.sh 会把下面存在的行自动注入每个新客户实例；
# 客户登录后仍可在「系统设置 → 密钥库」改成自己的 key（自付费）。
#
# 双模型都必须配置：Gemini 经 OpenRouter 负责主分析，DeepSeek 官网 API 负责独立审查。
# 两者之间不会静默降级或互相接管。

OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.1-pro-preview

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
LLM_CRITIC_REQUIRED_FOR_LIVE=true
