# Runtime
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:5173
AUTH_REQUIRED=true
ADMIN_PASSWORD=
PUBLIC_REGISTRATION_ENABLED=false
# Keep false until every trading-domain repository is physically partitioned
# by tenant_id and cross-tenant authorization tests pass.
TENANT_ISOLATION_V2=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
LOGIN_MAX_ATTEMPTS=8

# SQLite is the default durable store. The file is created under DATA_DIR as
# trading-agent.sqlite and can migrate the old data/db.json on first boot.

# Live trading is disabled by default. Both switches must be true before
# private exchange write calls are allowed.
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_REAL_TRADING=false
REAL_ORDER_WRITE_ENABLED=false
MAX_LIVE_NOTIONAL_USDT=50
REALTIME_RECONCILER_ENABLED=false
REQUIRE_PAPER_VALIDATION=true
MIN_FORWARD_TRADES=30
KNOWLEDGE_SKILL_MIN_LIVE_TRADES=10
# Only these directories may be read by the local-path knowledge importer.
# Prefer file upload in remote deployments. Separate multiple roots with the OS path delimiter.
KNOWLEDGE_ALLOWED_PATHS=
KNOWLEDGE_SIGNAL_MAX_AGE_MS=7200000
PAPER_FEE_BPS=4
PAPER_SLIPPAGE_BPS=3
EVENT_RISK_PAST_WINDOW_MS=21600000
EVENT_RISK_FUTURE_WINDOW_MS=86400000

# Optional private exchange credentials. Secrets are read only by exchange
# connectors and are never written to logs, traces, or frontend payloads.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_SPOT_BASE_URL=
BINANCE_USDM_BASE_URL=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_MARGIN_MODE=cross
OKX_POSITION_MODE=net_mode
OKX_AUTO_SET_LEVERAGE=false
OKX_DEMO_TRADING=false
OKX_BASE_URL=https://www.okx.com

# Security / operations
SECRETS_MASTER_KEY=
# Production: mount a KMS/Vault-managed key file and require the external provider.
SECRETS_MASTER_KEY_FILE=
REQUIRE_EXTERNAL_KEY_PROVIDER=false
WORM_AUDIT_ENDPOINT=
WORM_AUDIT_TOKEN=
WORM_AUDIT_SINK_ID=primary
ALERT_WEBHOOK_URL=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-trading-agent
ETHERSCAN_API_KEY=
TRC20_USDT_RECEIVE_ADDRESS=
TRONGRID_API_KEY=

# Optional LangSmith deep link prefix. Trace ids are stored locally either way.
LANGSMITH_TRACE_BASE_URL=

# OpenAI Responses API provider. When unset, Agent uses deterministic local
# strategy generation for development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Web Search providers. Configure one or more; ToolRouter will use the first
# available provider unless the request specifies one.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# BrowserTool / Playwright. If Playwright browsers are not installed, either run
# `pnpm exec playwright install chromium` or point to an existing Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
BROWSER_NAVIGATION_TIMEOUT_MS=15000
BROWSER_WRITE_ACTIONS_ENABLED=false

# Third-party Skill execution is containerized. Pre-pull or override this image
# in production if outbound image pulls are not allowed.
SKILL_SANDBOX_IMAGE=node:20-alpine
